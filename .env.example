# Copy to .env and fill in. The same names are set as Heroku config vars.

# Neon Postgres: pooled connection string (host contains "-pooler"), used by the app at runtime
DATABASE_URL=
# Neon Postgres: direct connection string (no "-pooler"), used by Prisma migrations
DIRECT_URL=

# Discord application (see #4)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
