# Copy to .env and fill in. The same names are set as Heroku config vars.

# Neon Postgres: pooled connection string (host contains "-pooler"), used by the app at runtime
DATABASE_URL=
# Neon Postgres: direct connection string (no "-pooler"), used by Prisma migrations
DIRECT_URL=

# Discord application (see #4)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the Discord app.
# Local: http://localhost:4200/api/auth/discord/callback (Angular dev server proxies /api)
DISCORD_REDIRECT_URI=
# Our server, and the role required to log in (Developer Mode → right-click → Copy ID)
DISCORD_GUILD_ID=
DISCORD_ROLE_ID=
# Comma-separated Discord user IDs with organizer powers on every draft
ADMIN_DISCORD_IDS=
