{
  "name": "swantisserie",
  "private": true,
  "workspaces": [
    "contract",
    "engine",
    "web",
    "api"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w api\" \"npm start -w web\"",
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run build -w contract -w engine && npm run typecheck --workspaces",
    "start": "npm run start:prod -w api",
    "lint": "npm run lint --workspaces",
    "format": "npm run format --workspaces",
    "format:check": "npm run format:check --workspaces"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@7.10.1": true,
    "@parcel/watcher@2.6.0": true,
    "@prisma/engines@7.10.1": true
  }
}
