generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// A Discord account that has signed in, or a bot an app admin added to a draft.
model User {
  /// Discord user ID (snowflake); `bot:<uuid>` for a bot.
  id                 String              @id
  /// Discord display name: global_name, falling back to username.
  name               String
  /// Discord avatar hash; null means the default avatar.
  avatar             String?
  /// A player the app controls. Bots can't sign in: they have no Discord account.
  isBot              Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sessions           Session[]
  /// Drafts this user organizes.
  drafts             Draft[]
  /// Drafts this user has joined.
  players            Player[]
  /// Feedback this user has sent.
  feedback           Feedback[]          @relation("FeedbackSender")
  /// Feedback this app admin has marked reviewed.
  reviewedFeedback   Feedback[]          @relation("FeedbackReviewedBy")
  /// Tournament matches this user reported.
  reportedMatches    Match[]
  /// The user's preferred printings, one at most per basic land, for their plans, decks and decklists in every draft.
  preferredPrintings PreferredPrinting[]
}

model Session {
  /// SHA-256 of the token in the session cookie, so a database leak can't be replayed.
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

enum DraftState {
  Lobby
  Drafting
  Frozen
  Complete
  Closed
}

model Draft {
  id             String            @id @default(uuid())
  name           String
  /// Which pool source defines the pool. A check constraint per kind requires that kind's columns and refuses the others.
  poolSourceKind PoolSourceKind
  /// The Scryfall search that defines the pool: set exactly when poolSourceKind is PoolQuery, by check constraint.
  poolQuery      String?
  /// The CubeCobra cube whose mainboard defines the pool, by id: set exactly when poolSourceKind is Cube, by check constraint.
  cubeId         String?
  /// The cube's name as it was when the draft was created: set exactly when poolSourceKind is Cube, by check constraint.
  cubeName       String?
  /// The sets whose cards define the pool, each with the sublists it includes, as [{code, sublists}] in Scryfall's lowercase set codes: set exactly when poolSourceKind is SetList, by check constraint.
  setList        Json?
  picksPerPlayer Int
  /// The game the draft is played on. Chosen at creation; it never changes.
  platform       Platform          @default(Arena)
  state          DraftState        @default(Lobby)
  organizerId    String
  organizer      User              @relation(fields: [organizerId], references: [id])
  /// Progress of copying the pool from Scryfall. The pool is fixed once Complete.
  snapshotState  PoolSnapshotState @default(Running)
  /// How many cards the pool will hold, as Scryfall or the cube says; null until it is known.
  poolTotal      Int?
  /// Why the last snapshot attempt failed; null otherwise.
  snapshotError  String?
  /// Where the draft's announcements are posted; null for none.
  webhookId      String?
  webhook        Webhook?          @relation(fields: [webhookId], references: [id], onDelete: SetNull)
  /// Goes up with every change to the draft's players, seats, state, picks or webhook, so viewers can tell which copy is newest.
  version        Int               @default(0)
  pool           PoolCard[]
  players        Player[]
  picks          Pick[]
  /// At most one, and only once the draft is complete.
  tournament     Tournament?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizerId])
  @@index([webhookId])
}

/// What defines a draft's pool. The api maps each to the contract's kind in one place (drafts/pool-source.ts).
enum PoolSourceKind {
  PoolQuery
  Cube
  SetList
}

/// How many cards a Scryfall set adds to a pool on a platform: its cards with a printing on the platform, basic lands left out. Counted in the background for the set list picker, and counted again once stale.
model SetCardCount {
  platform  Platform
  /// Scryfall's set code, lowercase.
  setCode   String
  cards     Int
  countedAt DateTime

  @@id([platform, setCode])
}

/// The game a draft is played on.
enum Platform {
  Arena
  MTGO
}

/// What a lost card does to a player's queue, whose rest stays in order either way: PauseQueue sets it queue paused; PickNext leaves it queue picking.
enum StealBehavior {
  PauseQueue
  PickNext
}

/// What losing a card did to its queue: paused it, under pause queue; left it queue picking, under pick next; or left it queue paused, as it was.
enum QueueLoss {
  PausedQueue
  LeftQueuePicking
  LeftQueuePaused
}

/// Progress of the pool snapshot: copying the pool's cards from Scryfall. A cube link's is Complete from creation.
enum PoolSnapshotState {
  Running
  Complete
  Failed
}

/// One copy of a card in a draft's pool, as snapshotted from Scryfall. A pool can hold several copies of the same card.
model PoolCard {
  id              String               @id @default(uuid())
  draftId         String
  draft           Draft                @relation(fields: [draftId], references: [id], onDelete: Cascade)
  /// Scryfall id of the printing on the draft's platform.
  scryfallId      String
  /// Identity shared by every printing of the card, and by every copy of it in the pool. A pool card is named by its own id, not this.
  oracleId        String
  name            String
  set             String
  collectorNumber String
  typeLine        String
  colors          String[]
  manaValue       Float
  /// Null when the faces carry it, as on double-faced cards.
  manaCost        String?
  /// Null when the faces carry it.
  oracleText      String?
  colorIdentity   String[]             @default([])
  keywords        String[]             @default([])
  /// How the card's faces are laid out, as Scryfall names it: normal, split, transform, adventure etc.
  layout          String
  /// common, uncommon, rare, special, mythic or bonus.
  rarity          String
  power           String?
  toughness       String?
  loyalty         String?
  defense         String?
  /// Each face's search fields, as CardFace[]: empty for single-faced cards.
  faces           Json
  /// Image URLs per face, as CardImages[]: one entry for single-faced cards, two when each face has its own image.
  images          Json
  /// Null until a player picks this card.
  pick            Pick?
  queued          QueuedCard[]
  takenOutQueued  TakenOutQueuedCard[]
  planned         PlannedCard[]
  lostPlanned     LostPlannedCard[]

  @@index([draftId])
}

/// A guild member or bot who has joined a draft.
model Player {
  id                 String               @id @default(uuid())
  draftId            String
  draft              Draft                @relation(fields: [draftId], references: [id], onDelete: Cascade)
  userId             String
  user               User                 @relation(fields: [userId], references: [id])
  joinedAt           DateTime             @default(now())
  /// Place in the seat order; null until the organizer sets it, which puts the player after every seated one, in join order. 0..n-1 once the draft has started.
  seat               Int?
  picks              Pick[]
  /// Bots have none.
  queue              QueuedCard[]
  takenOutQueued     TakenOutQueuedCard[]
  /// Private to the player, like their queue.
  plan               PlannedCard[]
  basics             PlannedBasic[]
  lostPlanned        LostPlannedCard[]
  /// The player's entry in the draft's tournament, if they have joined it.
  tournamentEntry    TournamentEntry?
  /// Private to the player, like their queue. Bots have no queue, so it does nothing for them.
  stealBehavior      StealBehavior        @default(PauseQueue)
  /// Whether the player's queue is paused, making no queued picks; every queue starts picking. Private to the player, like their queue.
  queuePaused        Boolean              @default(false)
  /// The key of the player's latest departure from their queue, 0 before the first. Only ever goes up, so departures order by it, never by time.
  lastQueueDeparture Int                  @default(0)

  @@unique([draftId, userId])
  @@index([userId])
}

/// One card taken by one player on their turn.
model Pick {
  id             String               @id @default(uuid())
  draftId        String
  draft          Draft                @relation(fields: [draftId], references: [id], onDelete: Cascade)
  /// 1-based, counting every pick in the draft.
  number         Int
  playerId       String
  player         Player               @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /// Unique: each pool card can be picked once.
  poolCardId     String               @unique
  poolCard       PoolCard             @relation(fields: [poolCardId], references: [id], onDelete: Cascade)
  createdAt      DateTime             @default(now())
  /// What undoing this pick puts back into queues.
  takenOutQueued TakenOutQueuedCard[]
  /// Its place in its player's plan, which undoing it takes away unless the player added the card first.
  planned        PlannedCard?
  /// What undoing this pick puts back into plans.
  lostPlanned    LostPlannedCard[]

  @@unique([draftId, number])
  @@index([playerId])
}

/// The part of a player's plan a card is on: the mainboard, which they intend to play, or the sideboard.
enum PlanBoard {
  Mainboard
  Sideboard
}

/// A card in a player's plan, on their mainboard or sideboard: one of their picks, or an unpicked pool card they added.
model PlannedCard {
  id             String    @id @default(uuid())
  playerId       String
  player         Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  poolCardId     String
  poolCard       PoolCard  @relation(fields: [poolCardId], references: [id], onDelete: Cascade)
  /// The pick it is, if it is one; an unpicked card has none.
  pickId         String?   @unique
  pick           Pick?     @relation(fields: [pickId], references: [id], onDelete: SetNull)
  board          PlanBoard @default(Mainboard)
  /// Whether the player added it with Add to Plan: undoing a pick of it then leaves it in the plan, unpicked, rather than taking it out.
  added          Boolean   @default(false)
  /// Its queue order: the player's `lastQueueDeparture` when this copy last left their queue, and its `position` there then. Null until it first leaves, and for a card taken out of the plan and added back.
  queueDeparture Int?
  queuePosition  Int?

  @@unique([playerId, poolCardId])
  @@index([poolCardId])
}

/// A basic land, which a plan holds by count on each plan board, and a pool never holds.
enum BasicLand {
  Plains
  Island
  Swamp
  Mountain
  Forest
}

/// The copies of one basic land on one plan board of a player's plan. Never a pool card: no one picks it, it is never queued, and no pick or undo changes it.
model PlannedBasic {
  id       String    @id @default(uuid())
  playerId String
  player   Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  land     BasicLand
  board    PlanBoard @default(Mainboard)
  /// At least 1, by check constraint: a basic with no copies on a plan board has no row for it.
  count    Int

  @@unique([playerId, land, board])
}

/// A player's preferred printing of one basic land: the printing its copies show in their plans, decks and decklists, in every draft. Changes only how the land looks, never an export or a decklist snapshot.
model PreferredPrinting {
  id         String            @id @default(uuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  land       BasicLand
  /// A stored printing of `land`.
  scryfallId String
  printing   BasicLandPrinting @relation(fields: [scryfallId], references: [scryfallId])

  @@unique([userId, land])
}

/// An English printing of a basic land with a single-faced image, as Scryfall last showed it: what the Printing picker offers and a preferred printing refers to. Refreshed from Scryfall when a new set comes out (ADR 0015), and never deleted.
model BasicLandPrinting {
  scryfallId      String              @id
  land            BasicLand
  /// Scryfall's set code, e.g. `ons`.
  setCode         String
  setName         String
  /// When the set was released.
  setReleasedAt   DateTime            @db.Date
  collectorNumber String
  /// The printing's images on Scryfall's CDN, `cards.scryfall.io`.
  imageSmall      String
  imageNormal     String
  imageLarge      String
  preferredBy     PreferredPrinting[]

  @@index([land])
}

/// The last refresh of the basic land printings to finish: one row at most.
model BasicLandPrintingRefresh {
  id        Int      @id @default(1)
  /// When it started: a set released since then may hold printings not stored yet.
  startedAt DateTime
}

/// An unpicked card lost from a plan: another player picked it, and no other copy was available for the plan. Kept until that pick is undone, which puts it back.
model LostPlannedCard {
  id           String    @id @default(uuid())
  pickId       String
  pick         Pick      @relation(fields: [pickId], references: [id], onDelete: Cascade)
  playerId     String
  player       Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  poolCardId   String
  poolCard     PoolCard  @relation(fields: [poolCardId], references: [id], onDelete: Cascade)
  /// The board it was on, which an undo puts it back on.
  board        PlanBoard
  /// Whether the Plan notice has stopped listing it: it was dismissed.
  noticeHidden Boolean   @default(false)

  @@unique([pickId, playerId])
  @@index([playerId])
  @@index([poolCardId])
  @@map("UnplannedCard")
}

/// A card in a player's queue.
model QueuedCard {
  id         String   @id @default(uuid())
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  poolCardId String
  poolCard   PoolCard @relation(fields: [poolCardId], references: [id], onDelete: Cascade)
  /// Order in the queue, lowest first; not necessarily consecutive.
  position   Int

  @@unique([playerId, poolCardId])
  @@index([poolCardId])
}

/// A taken-out queued card: one a pick took out of a player's queue, the card the player picked from their own queue, or, after another player's pick, the lost card, or a card it cleared under clear queue before pause queue replaced it. Kept until that pick is undone, which puts it back.
model TakenOutQueuedCard {
  id           String   @id @default(uuid())
  pickId       String
  pick         Pick     @relation(fields: [pickId], references: [id], onDelete: Cascade)
  playerId     String
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  poolCardId   String
  poolCard     PoolCard @relation(fields: [poolCardId], references: [id], onDelete: Cascade)
  /// Where it was in the queue, lowest first.
  position     Int
  /// Whether the Queue notice has stopped listing it: it was dismissed, or the card was queued again. Always true for a player's own picked card, which the notice never lists: it was picked, not lost.
  noticeHidden Boolean  @default(false)
  /// Whether anything else stayed queued when this card was lost; false for the last card left in a queue, and under clear queue, before pause queue replaced it, for a lost or cleared card. Always true for a player's own picked card, so that an undo puts it back in its old place.
  restKept     Boolean  @default(false)
  /// For a lost card, what losing it did to the queue; an undo of a pick that paused the queue sets it queue picking again. Null for any other card, and for a card lost before pause queue replaced clear queue.
  queueLoss    QueueLoss?

  @@unique([pickId, playerId, poolCardId])
  @@index([playerId])
  @@index([poolCardId])
  @@map("UnqueuedCard")
}

/// A named Discord webhook an app admin registered, which organizers choose for a draft's announcements.
model Webhook {
  id        String    @id @default(uuid())
  /// What organizers choose it by, e.g. "#roto-main".
  name      String    @unique
  /// A secret: only app admins may see it.
  url       String
  /// When Discord stopped accepting posts on it (a 404 or 401); null while it does. Replacing its URL clears it.
  goneAt    DateTime?
  drafts    Draft[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// A plain-text message a guild member sent to the app admins.
model Feedback {
  id           String    @id @default(uuid())
  message      String
  senderId     String
  sender       User      @relation("FeedbackSender", fields: [senderId], references: [id])
  /// The path of the page it was sent from, with its query and hash.
  pagePath     String
  sentAt       DateTime  @default(now())
  /// The app admin who marked it reviewed; null while it is unreviewed.
  reviewedById String?
  reviewedBy   User?     @relation("FeedbackReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt   DateTime?

  @@index([senderId])
  @@index([reviewedById])
}

/// How a tournament pairs its players.
enum TournamentFormat {
  RoundRobin
  Swiss
  SingleElimination
}

/// How many tournament rounds a Swiss tournament plays: until there's a winner, or capped at 3.
enum SwissRoundOption {
  UntilWinner
  CappedAt3
}

/// Registration → Playing → Complete.
enum TournamentState {
  Registration
  Playing
  Complete
}

/// The matches a complete draft's players play after the draft. At most one per draft; cancelling it deletes it.
model Tournament {
  id                 String            @id @default(uuid())
  /// Unique: a draft has at most one tournament.
  draftId            String            @unique
  draft              Draft             @relation(fields: [draftId], references: [id], onDelete: Cascade)
  /// Chosen at tournament setup; it never changes.
  format             TournamentFormat
  /// A Swiss tournament's round option, chosen at tournament setup; null in other formats.
  swissRoundOption   SwissRoundOption?
  /// Whether it has public decklists, chosen at tournament setup; it never changes.
  publicDecklists    Boolean           @default(false)
  state              TournamentState   @default(Registration)
  /// The last tournament round an organizer completed, from 1; 0 before any, and always in round robin.
  lastCompletedRound Int               @default(0)
  /// The tournament round an organizer reopened, which hasn't been completed again since; null otherwise. Only one round is reopened at a time.
  reopenedRound      Int?
  entries            TournamentEntry[]
  /// Byes included. Round robin makes every match at Start; Swiss and single elimination make round 1's at Start and each later round's when the one before is completed.
  matches            Match[]
  createdAt          DateTime          @default(now())
  /// When the organizer started it; null during registration.
  startedAt          DateTime?
  /// When it completed, set once in the transaction that marks it Complete; null until then, and for tournaments that completed before this was recorded.
  completedAt        DateTime?
}

/// A draft's player who has joined its tournament. While the tournament is in Registration or Playing, it locks the player's deck.
model TournamentEntry {
  id                String     @id @default(uuid())
  tournamentId      String
  tournament        Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  /// Unique: a player joins their draft's one tournament at most once.
  playerId          String     @unique
  player            Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  joinedAt          DateTime   @default(now())
  /// Whether the player has dropped from the tournament; their played matches stand.
  dropped           Boolean    @default(false)
  /// Whether the player has marked themselves ready during registration; never a bot. A new entry starts not ready, and nothing after Start reads it.
  ready             Boolean    @default(false)
  /// Whether the player's Ready notice shows on their Deck tab: set only when a deck change clears their ready automatically, and cleared when they dismiss it, mark themselves ready again, or registration ends: Start clears it, and cancelling the tournament deletes the entry. Only the player sees it.
  readyNotice       Boolean    @default(false)
  /// While dropped, the tournament round whose completion the drop came after: the last completed round when the player dropped, or the round Complete round was completing when it dropped them; 0 before any. Reopening round N takes back the drops after N or later. Null while not dropped, and for drops made before this was recorded.
  droppedAfterRound Int?
  /// Single elimination only: the entry's place in the seed order, from 1, shuffled at Start; null otherwise.
  seed              Int?
  /// The player's deck as it was locked when the tournament started, bots' included, whatever the tournament's public decklists setting (`PlanBoards` in `api/src/drafts/plans.service.ts`), so a later change to it never shows; null before Start, and for tournaments that completed before every deck was kept (ADR 0017).
  decklist          Json?
  /// Matches this entry plays first, whose game scores list its games first, and its byes.
  firstMatches      Match[]    @relation("FirstEntry")
  /// Matches this entry plays second.
  secondMatches     Match[]    @relation("SecondEntry")

  @@index([tournamentId])
}

/// How a match stands: unreported, or decided by a game score, a granted draw, a forfeit or, in single elimination, a granted win.
enum MatchOutcomeKind {
  Unreported
  GameScore
  GrantedDraw
  Forfeit
  GrantedWin
}

/// One of a match's two entries: the first, whose games a game score lists first, or the second.
enum MatchSide {
  First
  Second
}

/// One match of a tournament, made when its tournament round is paired, or a bye: an entry sitting a tournament round out.
model Match {
  id            String           @id @default(uuid())
  tournamentId  String
  tournament    Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  /// The tournament round, from 1. Round robin has no tournament rounds, so every match of one is in round 1.
  round         Int
  /// Single elimination only: its bracket place within its tournament round, from 0; bracket place p is fed by places 2p and 2p + 1 of the round before. Null otherwise.
  bracketPlace  Int?
  firstEntryId  String
  firstEntry    TournamentEntry  @relation("FirstEntry", fields: [firstEntryId], references: [id], onDelete: Cascade)
  /// Null for a bye, whose one entry is the first.
  secondEntryId String?
  secondEntry   TournamentEntry? @relation("SecondEntry", fields: [secondEntryId], references: [id], onDelete: Cascade)
  /// Always Unreported for a bye.
  outcome       MatchOutcomeKind @default(Unreported)
  /// Games won by the first entry, for a game score; 0 otherwise.
  firstGames    Int              @default(0)
  /// Games won by the second entry, for a game score; 0 otherwise.
  secondGames   Int              @default(0)
  /// Drawn games, for a game score; 0 otherwise.
  drawnGames    Int              @default(0)
  /// The side that forfeited, for a forfeit; null otherwise.
  forfeitedBy   MatchSide?
  /// The side the organizer picked to win, for a granted win; null otherwise.
  grantedTo     MatchSide?
  /// Who reported it, a player or an organizer; null until it is reported, and for a granted draw or win.
  reportedById  String?
  reportedBy    User?            @relation(fields: [reportedById], references: [id], onDelete: SetNull)
  /// Whether the other player confirmed the game score it was reported with.
  confirmed     Boolean          @default(false)

  @@unique([tournamentId, round, bracketPlace])
  @@index([tournamentId])
  @@index([firstEntryId])
  @@index([secondEntryId])
}
