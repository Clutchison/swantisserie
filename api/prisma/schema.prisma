generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// A Discord account that has signed in, or a bot an app admin added to a draft.
model User {
  /// Discord user ID (snowflake); `bot:<uuid>` for a bot.
  id               String     @id
  /// Discord display name: global_name, falling back to username.
  name             String
  /// Discord avatar hash; null means the default avatar.
  avatar           String?
  /// A player the app controls. Bots can't sign in: they have no Discord account.
  isBot            Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  sessions         Session[]
  /// Drafts this user organizes.
  drafts           Draft[]
  /// Drafts this user has joined.
  players          Player[]
  /// Feedback this user has sent.
  feedback         Feedback[] @relation("FeedbackSender")
  /// Feedback this app admin has marked reviewed.
  reviewedFeedback Feedback[] @relation("FeedbackReviewedBy")
}

model Session {
  /// SHA-256 of the token in the session cookie, so a database leak can't be replayed.
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

enum DraftState {
  Lobby
  Drafting
  Paused
  Complete
  Closed
}

model Draft {
  id             String            @id @default(uuid())
  name           String
  /// Which pool source defines the pool. A check constraint per kind requires that kind's columns and refuses the others.
  poolSourceKind PoolSourceKind
  /// The Scryfall search that defines the pool: set exactly when poolSourceKind is PoolQuery, by check constraint.
  poolQuery      String?
  /// The CubeCobra cube whose mainboard defines the pool, by id: set exactly when poolSourceKind is Cube, by check constraint.
  cubeId         String?
  /// The cube's name as it was when the draft was created: set exactly when poolSourceKind is Cube, by check constraint.
  cubeName       String?
  picksPerPlayer Int
  /// The game the draft is played on. Chosen at creation; it never changes.
  platform       Platform          @default(Arena)
  state          DraftState        @default(Lobby)
  organizerId    String
  organizer      User              @relation(fields: [organizerId], references: [id])
  /// Progress of copying the pool from Scryfall. The pool is frozen once Complete.
  snapshotState  PoolSnapshotState @default(Running)
  /// How many cards the pool will hold, as Scryfall or the cube says; null until it is known.
  poolTotal      Int?
  /// Why the last snapshot attempt failed; null otherwise.
  snapshotError  String?
  /// Where the draft's announcements are posted; null for none.
  webhookId      String?
  webhook        Webhook?          @relation(fields: [webhookId], references: [id], onDelete: SetNull)
  /// Goes up with every change to the draft's players, seats, state, picks or webhook, so viewers can tell which copy is newest.
  version        Int               @default(0)
  pool           PoolCard[]
  players        Player[]
  picks          Pick[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizerId])
  @@index([webhookId])
}

/// What defines a draft's pool. The api maps each to the contract's kind in one place (drafts/pool-source.ts).
enum PoolSourceKind {
  PoolQuery
  Cube
}

/// The game a draft is played on.
enum Platform {
  Arena
  MTGO
}

/// What a lost card does to the rest of a player's queue: ClearQueue clears it; PickNext keeps it, in order.
enum StealBehavior {
  ClearQueue
  PickNext
}

/// Progress of the pool snapshot: copying the pool's cards from Scryfall. A cube link's is Complete from creation.
enum PoolSnapshotState {
  Running
  Complete
  Failed
}

/// One copy of a card in a draft's pool, as snapshotted from Scryfall. A pool can hold several copies of the same card.
model PoolCard {
  id              String               @id @default(uuid())
  draftId         String
  draft           Draft                @relation(fields: [draftId], references: [id], onDelete: Cascade)
  /// Scryfall id of the printing on the draft's platform.
  scryfallId      String
  /// Identity shared by every printing of the card, and by every copy of it in the pool. A pool card is named by its own id, not this.
  oracleId        String
  name            String
  set             String
  collectorNumber String
  typeLine        String
  colors          String[]
  manaValue       Float
  /// Null when the faces carry it, as on double-faced cards.
  manaCost        String?
  /// Null when the faces carry it.
  oracleText      String?
  colorIdentity   String[]             @default([])
  keywords        String[]             @default([])
  /// How the card's faces are laid out, as Scryfall names it: normal, split, transform, adventure etc.
  layout          String
  /// common, uncommon, rare, special, mythic or bonus.
  rarity          String
  power           String?
  toughness       String?
  loyalty         String?
  defense         String?
  /// Each face's search fields, as CardFace[]: empty for single-faced cards.
  faces           Json
  /// Image URLs per face, as CardImages[]: one entry for single-faced cards, two when each face has its own image.
  images          Json
  /// Null until a player picks this card.
  pick            Pick?
  queued          QueuedCard[]
  takenOutQueued  TakenOutQueuedCard[]
  planned         PlannedCard[]
  lostPlanned     LostPlannedCard[]

  @@index([draftId])
}

/// A guild member or bot who has joined a draft.
model Player {
  id             String               @id @default(uuid())
  draftId        String
  draft          Draft                @relation(fields: [draftId], references: [id], onDelete: Cascade)
  userId         String
  user           User                 @relation(fields: [userId], references: [id])
  joinedAt       DateTime             @default(now())
  /// Place in the seat order; null until the organizer sets it, which puts the player after every seated one, in join order. 0..n-1 once the draft has started.
  seat           Int?
  picks          Pick[]
  /// Bots have none.
  queue          QueuedCard[]
  takenOutQueued TakenOutQueuedCard[]
  /// Private to the player, like their queue.
  plan           PlannedCard[]
  basics         PlannedBasic[]
  lostPlanned    LostPlannedCard[]
  /// Private to the player, like their queue. Bots have no queue, so it does nothing for them.
  stealBehavior  StealBehavior        @default(ClearQueue)

  @@unique([draftId, userId])
  @@index([userId])
}

/// One card taken by one player on their turn.
model Pick {
  id             String               @id @default(uuid())
  draftId        String
  draft          Draft                @relation(fields: [draftId], references: [id], onDelete: Cascade)
  /// 1-based, counting every pick in the draft.
  number         Int
  playerId       String
  player         Player               @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /// Unique: each pool card can be picked once.
  poolCardId     String               @unique
  poolCard       PoolCard             @relation(fields: [poolCardId], references: [id], onDelete: Cascade)
  createdAt      DateTime             @default(now())
  /// What undoing this pick puts back into queues.
  takenOutQueued TakenOutQueuedCard[]
  /// Its place in its player's plan, which undoing it takes away unless the player added the card first.
  planned        PlannedCard?
  /// What undoing this pick puts back into plans.
  lostPlanned    LostPlannedCard[]

  @@unique([draftId, number])
  @@index([playerId])
}

/// The part of a player's plan a card is on: the mainboard, which they intend to play, or the sideboard.
enum PlanBoard {
  Mainboard
  Sideboard
}

/// A card in a player's plan, on their mainboard or sideboard: one of their picks, or an unpicked pool card they added.
model PlannedCard {
  id         String    @id @default(uuid())
  playerId   String
  player     Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  poolCardId String
  poolCard   PoolCard  @relation(fields: [poolCardId], references: [id], onDelete: Cascade)
  /// The pick it is, if it is one; an unpicked card has none.
  pickId     String?   @unique
  pick       Pick?     @relation(fields: [pickId], references: [id], onDelete: SetNull)
  board      PlanBoard @default(Mainboard)
  /// Whether the player added it with Add to Plan: undoing a pick of it then leaves it in the plan, unpicked, rather than taking it out.
  added      Boolean   @default(false)

  @@unique([playerId, poolCardId])
  @@index([poolCardId])
}

/// A basic land, which a plan holds by count on its mainboard, and a pool never holds.
enum BasicLand {
  Plains
  Island
  Swamp
  Mountain
  Forest
  Wastes
}

/// The copies of one basic land in a player's plan, always on the mainboard. Never a pool card: no one picks it, it is never queued, and no pick or undo changes it.
model PlannedBasic {
  id       String    @id @default(uuid())
  playerId String
  player   Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  land     BasicLand
  /// At least 1, by check constraint: a basic with no copies has no row.
  count    Int

  @@unique([playerId, land])
}

/// An unpicked card lost from a plan: another player picked it, and no other copy was available for the plan. Kept until that pick is undone, which puts it back.
model LostPlannedCard {
  id           String    @id @default(uuid())
  pickId       String
  pick         Pick      @relation(fields: [pickId], references: [id], onDelete: Cascade)
  playerId     String
  player       Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  poolCardId   String
  poolCard     PoolCard  @relation(fields: [poolCardId], references: [id], onDelete: Cascade)
  /// The board it was on, which an undo puts it back on.
  board        PlanBoard
  /// Whether the Plan notice has stopped listing it: it was dismissed.
  noticeHidden Boolean   @default(false)

  @@unique([pickId, playerId])
  @@index([playerId])
  @@index([poolCardId])
  @@map("UnplannedCard")
}

/// A card in a player's queue.
model QueuedCard {
  id         String   @id @default(uuid())
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  poolCardId String
  poolCard   PoolCard @relation(fields: [poolCardId], references: [id], onDelete: Cascade)
  /// Order in the queue, lowest first; not necessarily consecutive.
  position   Int

  @@unique([playerId, poolCardId])
  @@index([poolCardId])
}

/// A queued card taken out by a pick: by another player's pick, lost if it is the card that pick took, else cleared; or by its own player's pick of it. Kept until that pick is undone, which puts it back.
model TakenOutQueuedCard {
  id           String   @id @default(uuid())
  pickId       String
  pick         Pick     @relation(fields: [pickId], references: [id], onDelete: Cascade)
  playerId     String
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  poolCardId   String
  poolCard     PoolCard @relation(fields: [poolCardId], references: [id], onDelete: Cascade)
  /// Where it was in the queue, lowest first.
  position     Int
  /// Whether the Queue tab notice has stopped listing it: it was dismissed, or the card was queued again. Always true for a player's own picked card, which the notice never lists: it was picked, not lost.
  noticeHidden Boolean  @default(false)
  /// Whether anything else stayed queued when this card was lost, as under pick next; false under clear queue, for a cleared card, and for the last card left in a queue. Always true for a player's own picked card, so that an undo puts it back in its old place.
  restKept     Boolean  @default(false)

  @@unique([pickId, playerId, poolCardId])
  @@index([playerId])
  @@index([poolCardId])
  @@map("UnqueuedCard")
}

/// A named Discord webhook an app admin registered, which organizers choose for a draft's announcements.
model Webhook {
  id        String   @id @default(uuid())
  /// What organizers choose it by, e.g. "#roto-main".
  name      String   @unique
  /// A secret: only app admins may see it.
  url       String
  drafts    Draft[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A plain-text message a guild member sent to the app admins.
model Feedback {
  id           String    @id @default(uuid())
  message      String
  senderId     String
  sender       User      @relation("FeedbackSender", fields: [senderId], references: [id])
  /// The path of the page it was sent from, with its query and hash.
  pagePath     String
  sentAt       DateTime  @default(now())
  /// The app admin who marked it reviewed; null while it is unreviewed.
  reviewedById String?
  reviewedBy   User?     @relation("FeedbackReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt   DateTime?

  @@index([senderId])
  @@index([reviewedById])
}
