generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// A Discord account that has signed in.
model User {
  /// Discord user ID (snowflake).
  id        String    @id
  /// Discord display name: global_name, falling back to username.
  name      String
  /// Discord avatar hash; null means the default avatar.
  avatar    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions  Session[]
  /// Drafts this user organizes.
  drafts    Draft[]
  /// Drafts this user has joined.
  players   Player[]
}

model Session {
  /// SHA-256 of the token in the session cookie, so a database leak can't be replayed.
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

enum DraftState {
  Lobby
  Drafting
  Paused
  Complete
}

model Draft {
  id             String            @id @default(uuid())
  name           String
  /// The Scryfall search that defines the pool.
  poolQuery      String
  picksPerPlayer Int
  state          DraftState        @default(Lobby)
  organizerId    String
  organizer      User              @relation(fields: [organizerId], references: [id])
  /// Progress of copying the pool from Scryfall. The pool is frozen once Complete.
  snapshotState  PoolSnapshotState @default(Running)
  /// How many cards Scryfall says the pool query matches; null until the first page arrives.
  poolTotal      Int?
  /// Why the last snapshot attempt failed; null otherwise.
  snapshotError  String?
  pool           PoolCard[]
  players        Player[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizerId])
}

/// Progress of the pool snapshot: copying the pool query's cards from Scryfall.
enum PoolSnapshotState {
  Running
  Complete
  Failed
}

/// One card in a draft's pool, as snapshotted from Scryfall.
model PoolCard {
  id              String   @id @default(uuid())
  draftId         String
  draft           Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  /// Scryfall id of the Arena printing.
  scryfallId      String
  /// Identity shared by every printing; the pick identity.
  oracleId        String
  name            String
  set             String
  collectorNumber String
  typeLine        String
  colors          String[]
  manaValue       Float
  /// Image URLs per face, as CardImages[]: one entry for single-faced cards, two when each face has its own image.
  images          Json

  @@unique([draftId, oracleId])
}

/// A role-holder who has joined a draft.
model Player {
  id       String   @id @default(uuid())
  draftId  String
  draft    Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  joinedAt DateTime @default(now())

  @@unique([draftId, userId])
  @@index([userId])
}
