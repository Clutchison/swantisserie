{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "prisma generate && nest build && node scripts/record-app-version.mjs dist/app-version.json",
    "typecheck": "prisma generate && tsc --noEmit",
    "dev": "prisma generate && nest start --watch --exec \"node --env-file-if-exists=../.env --enable-source-maps\"",
    "start:prod": "node --enable-source-maps dist/main.js",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "lint": "oxlint --type-aware src/",
    "format": "prettier . --ignore-path ../.gitignore --ignore-path .prettierignore --write",
    "format:check": "prettier . --ignore-path ../.gitignore --ignore-path .prettierignore --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mutation": "prisma generate && stryker run"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.3.2",
    "@nestjs/serve-static": "^12.1.1",
    "@nestjs/websockets": "^12.3.2",
    "@prisma/adapter-pg": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "contract": "*",
    "cookie-parser": "^1.4.7",
    "engine": "*",
    "prisma": "~7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@electric-sql/pglite-socket": "0.2.12",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "pg": "^8.23.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0"
  }
}
