{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "prisma generate && nest build",
    "typecheck": "prisma generate && tsc --noEmit",
    "dev": "prisma generate && nest start --watch --exec \"node --env-file-if-exists=../.env --enable-source-maps\"",
    "start:prod": "node --enable-source-maps dist/main.js",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "oxlint --type-aware src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/serve-static": "^12.1.1",
    "@prisma/adapter-pg": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "cookie-parser": "^1.4.7",
    "prisma": "~7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "engine": "*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@electric-sql/pglite-socket": "0.2.12",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
